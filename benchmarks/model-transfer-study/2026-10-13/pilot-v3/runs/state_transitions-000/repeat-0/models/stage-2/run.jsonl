{"type": "tool", "number": 4, "action": "read", "arguments": {"path": "work.py"}, "result": {"ok": true, "result": {"content": "\"\"\"Evaluate policy-controlled state transitions.\"\"\"\n\n\ndef evaluate(request, policy):\n    \"\"\"Return the result of a requested state transition without mutation.\"\"\"\n    edge_key = f\"{request.get('from')}>{request.get('to')}\"\n    edge = policy.get(\"edges\", {}).get(edge_key)\n\n    if edge is None:\n        return {\"ok\": False, \"value\": None, \"reason\": \"blocked\"}\n\n    required_role = edge.get(\"role\")\n    if required_role is not None and request.get(\"role\") != required_role:\n        return {\"ok\": False, \"value\": None, \"reason\": \"permission\"}\n\n    if request.get(\"retry\") is True:\n        attempts = request.get(\"attempts\")\n        retry_limit = policy.get(\"retry_limit\")\n        valid_attempts = (\n            isinstance(attempts, int)\n            and not isinstance(attempts, bool)\n            and isinstance(retry_limit, int)\n            and not isinstance(retry_limit, bool)\n            and 0 <= attempts < retry_limit\n        )\n        if not valid_attempts:\n            return {\"ok\": False, \"value\": None, \"reason\": \"retry_limit\"}\n\n    return {\"ok\": True, \"value\": request.get(\"to\"), \"reason\": \"ok\"}\n"}}}
